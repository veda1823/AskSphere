# Server Configuration
PORT=5000

# PostgreSQL Connection String (Neon, Supabase, or local Postgres)
# Example for Neon: postgresql://neondb_owner:PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for Supabase: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asksphere?sslmode=prefer"

# JWT Authentication Secret (use a secure random string)
JWT_SECRET="asksphere_super_secret_jwt_key_development_2026"

# Frontend Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
